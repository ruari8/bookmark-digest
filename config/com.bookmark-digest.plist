<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bookmark-digest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ruari/Documents/Startups/learn/bookmark-digest/.venv/bin/python</string>
        <string>/Users/ruari/Documents/Startups/learn/bookmark-digest/run.py</string>
        <string>--output-format</string>
        <string>pdf</string>
        <string>--email</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <!-- Run every Sunday at 8:00 AM -->
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/ruari/Documents/Startups/learn/bookmark-digest/data/launchd.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ruari/Documents/Startups/learn/bookmark-digest/data/launchd.error.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/ruari/Documents/Startups/learn/bookmark-digest</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
